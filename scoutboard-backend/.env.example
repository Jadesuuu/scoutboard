# --- Data stores ---
# Local: mongodb://localhost:27017/scoutboard   Prod: MongoDB Atlas SRV string
MONGODB_URI=mongodb://localhost:27017/scoutboard
# Local: redis://localhost:6379                 Prod: Upstash / Redis Cloud (rediss:// works)
REDIS_URL=redis://localhost:6379

# --- AI listing analyst (any OpenAI-compatible chat-completions endpoint) ---
# Leave AI_API_KEY empty to run without AI; the analyze endpoint returns a graceful fallback.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Global cap on outbound AI calls per UTC day, all visitors combined. Unset/0 = unlimited.
AI_DAILY_LIMIT=
# How long a listing's analysis stays cached, in seconds. Default 3600.
AI_CACHE_TTL_SECONDS=

# --- Demo / deployment ---
# Market simulator cron: posts a realistic offer on a random listing every 5 minutes.
SIMULATOR_ENABLED=true
# Comma-separated browser origins allowed for HTTP + WebSocket. Default http://localhost:3001
CORS_ORIGIN=http://localhost:3001
# When set, DELETE /listings/:id/delete requires an `x-admin-key` header with this value.
ADMIN_API_KEY=
# PORT is injected by most hosts (Render, Railway). Defaults to 3000.
